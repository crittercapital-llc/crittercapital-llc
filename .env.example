# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Whoop OAuth2
# Register your app at https://developer.whoop.com
# Set redirect URI to: https://<your-replit-url>/auth/whoop/callback
WHOOP_CLIENT_ID=your_whoop_client_id
WHOOP_CLIENT_SECRET=your_whoop_client_secret

# Strava OAuth2
# Register your app at https://developers.strava.com
# Set redirect URI to: https://<your-replit-url>/auth/strava/callback
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Storage
DB_PATH=./fitness_agent.db

# Session signing (generate a random string)
SECRET_KEY=change-me-to-a-random-secret
